<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= config.store_name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="main-header">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="logo"><%= config.store_name %></a>
        <nav class="social-nav">
          <% if(config.whatsapp_number) { %><a href="https://wa.me/<%= config.whatsapp_number %>" target="_blank" class="social-link wa">WhatsApp</a><% } %>
          <% if(config.instagram) { %><a href="<%= config.instagram %>" target="_blank" class="social-link ig">Instagram</a><% } %>
        </nav>
      </div>
    </div>
  </header>
  <main class="main-content">
