<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-wrapper">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
      <div class="sidebar-header">
        <h2>Store CMS</h2>
      </div>
      <nav class="sidebar-nav">
        <ul>
          <li><a href="/admin" class="nav-link">Dashboard</a></li>
          <li><a href="/admin/categories" class="nav-link">Categories</a></li>
          <li><a href="/admin/products" class="nav-link">Products</a></li>
          <li><a href="/admin/settings" class="nav-link">Settings</a></li>
        </ul>
      </nav>
      <div class="sidebar-footer">
        <a href="/admin/logout" class="btn btn-danger btn-block">Logout</a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="admin-main">
      <header class="admin-header">
        <div class="header-left">
          <button id="sidebar-toggle" class="btn-icon">&#9776;</button>
          <h3>Welcome, Admin</h3>
        </div>
        <div class="header-right">
          <a href="/" target="_blank" class="btn btn-outline">View Store</a>
        </div>
      </header>
      <div class="admin-content">
